DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
DIRECTUS_ADMIN_TOKEN=change-this-local-token
DIRECTUS_SECRET=change-this-secret-to-at-least-32-bytes
DIRECTUS_URL=http://localhost:8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
POSTGRES_PASSWORD=change-this-database-password

# R2's S3-compatible API. Create an Object Read & Write token scoped to the
# production assets bucket and use its Access Key ID and Secret Access Key.
STORAGE_PUBLISH_BUCKET=
STORAGE_PUBLISH_ENDPOINT=
STORAGE_PUBLISH_FORCE_PATH_STYLE=false
STORAGE_PUBLISH_KEY=
STORAGE_PUBLISH_REGION=auto
STORAGE_PUBLISH_SECRET=
