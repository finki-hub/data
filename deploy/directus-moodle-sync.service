[Unit]
Description=Refresh the FINKI Hub Moodle snapshot with courses-scraper
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# The host's Discord alert (directus-alert@.service).
OnFailure=directus-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/directus
ExecStart=/usr/bin/docker compose --profile jobs run --rm --no-deps moodle-sync
TimeoutStartSec=6h
Nice=10
