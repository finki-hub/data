{
  "name": "directus-extension-course-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "directus-extension build"
  },
  "dependencies": {
    "@directus/extensions-sdk": "^18.0.4",
    "@directus/types": "18.1.0",
    "@tanstack/vue-virtual": "^3.13.36",
    "vue": "3.5.45",
    "zod": "^4.5.4"
  },
  "directus:extension": {
    "type": "bundle",
    "path": { "app": "dist/app.js", "api": "dist/api.js" },
    "entries": [
      { "type": "layout", "name": "finki-hub-course-search", "source": "src/index.ts" },
      { "type": "endpoint", "name": "finki-hub-course-history", "source": "src/endpoint.ts" }
    ],
    "host": "^12.0.0"
  }
}
