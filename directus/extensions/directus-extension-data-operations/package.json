{
  "name": "directus-extension-data-operations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "directus-extension build"
  },
  "dependencies": {
    "@directus/extensions-sdk": "^18.0.4",
    "@directus/types": "18.1.0",
    "vue": "3.5.45",
    "zod": "^4.5.4"
  },
  "directus:extension": {
    "type": "bundle",
    "path": { "app": "dist/app.js", "api": "dist/api.js" },
    "entries": [
      { "type": "endpoint", "name": "finki-hub-data-operations", "source": "src/index.ts" },
      { "type": "operation", "name": "finki-hub-data-coordinate", "source": { "app": "src/app.ts", "api": "src/coordinate.ts" } },
      { "type": "hook", "name": "finki-hub-data-recovery", "source": "src/recovery.ts" },
      { "type": "hook", "name": "finki-hub-write-guard", "source": "src/write-guard.ts" },
      { "type": "hook", "name": "finki-hub-pattern-guard", "source": "src/pattern-guard.ts" },
      { "type": "hook", "name": "finki-hub-course-default-mapping", "source": "src/course-default-mapping.ts" },
      { "type": "operation", "name": "finki-hub-snapshot-import", "source": { "app": "src/snapshot-import-app.ts", "api": "src/snapshot-import.ts" } },
      { "type": "operation", "name": "finki-hub-snapshot-promote", "source": { "app": "src/snapshot-promote-app.ts", "api": "src/snapshot-promote.ts" } },
      { "type": "endpoint", "name": "finki-hub-data-status", "source": "src/status-endpoint.ts" },
      { "type": "endpoint", "name": "legacy", "source": "src/legacy-endpoint.ts" },
      { "type": "panel", "name": "finki-hub-run-operation", "source": "src/panel.ts" },
      { "type": "panel", "name": "finki-hub-data-status-panel", "source": "src/status-panel.ts" }
    ],
    "host": "^12.0.0"
  }
}
