{
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^18.1.1",
    "@directus/types": "19.0.0",
    "@playwright/test": "^1.65.1",
    "@tanstack/vue-virtual": "^3.13.52",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-imperium": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "vue": "3.5.43",
    "vue-tsc": "^3.3.14"
  },
  "license": "MIT",
  "name": "finki-hub-data-migration",
  "private": true,
  "scripts": {
    "brand": "node --env-file-if-exists=.env --import tsx src/branding-cli.ts",
    "build:operations": "npm --prefix directus/extensions/directus-extension-data-operations run build",
    "build:search": "npm --prefix directus/extensions/directus-extension-course-search run build",
    "check": "tsc --noEmit && npm run check:sfc",
    "check:sfc": "vue-tsc --noEmit --project tsconfig.sfc.json",
    "check:exports": "node --import tsx src/export-check-cli.ts",
    "format": "eslint . --cache --fix",
    "generate:api-docs": "node --import tsx src/api-docs-model-snapshot.ts",
    "generate:invalidation": "node --import tsx src/source-invalidation-snapshot.ts",
    "lint": "eslint . --cache",
    "setup": "node --import tsx src/setup-cli.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "playwright install --with-deps chromium",
    "test:integration": "node --import tsx --test test/deployment.integration.ts",
    "test:csv": "node --import tsx --test test/directus-csv-import.integration.ts",
    "test:search": "node --import tsx --test --test-concurrency=1 test/search.integration.ts"
  },
  "type": "module",
  "version": "0.0.0"
}
